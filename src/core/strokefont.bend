import Base
import ./board.bend as B

# A stroke (vector) font for schematic and board text: the Hershey simplex
# roman glyphs (public domain; A. V. Hershey, NBS 1967), close to the
# stroke font KiCad draws with. Generated by scripts/strokefont-to-bend.py;
# do not edit the glyph table by hand.
#
# Glyph units: x right, y down, capitals from y = -12 to the baseline at
# y = 9 (21 units = one text height). Coordinates are stored plus 64.

type GP is Data:
  GP{x: U32, y: U32}

# left and right bearings, and the strokes (polylines)
type Glyph is Data:
  Glyph{l: U32, r: U32, strokes: List<&2, List<&2, GP>>}

# a hollow box for code points the font lacks
def Stroke.box() -> Glyph:
  Glyph{56, 72, [[GP{59, 52}, GP{69, 52}, GP{69, 73}, GP{59, 73}, GP{59, 52}]]}

# printable ASCII and a few Latin-1 signs
def Stroke.low(cp: Nat) -> Glyph:
  match cp:
    case 32n:
      Glyph{56, 72, []}
    case 33n:
      Glyph{59, 69, [[GP{64, 52}, GP{64, 66}], [GP{64, 71}, GP{63, 72}, GP{64, 73}, GP{65, 72}, GP{64, 71}]]}
    case 34n:
      Glyph{56, 72, [[GP{60, 52}, GP{60, 59}], [GP{68, 52}, GP{68, 59}]]}
    case 35n:
      Glyph{54, 75, [[GP{65, 48}, GP{58, 80}], [GP{71, 48}, GP{64, 80}], [GP{58, 61}, GP{72, 61}], [GP{57, 67}, GP{71, 67}]]}
    case 36n:
      Glyph{54, 74, [[GP{62, 48}, GP{62, 77}], [GP{66, 48}, GP{66, 77}], [GP{71, 55}, GP{69, 53}, GP{66, 52}, GP{62, 52}, GP{59, 53}, GP{57, 55}, GP{57, 57}, GP{58, 59}, GP{59, 60}, GP{61, 61}, GP{67, 63}, GP{69, 64}, GP{70, 65}, GP{71, 67}, GP{71, 70}, GP{69, 72}, GP{66, 73}, GP{62, 73}, GP{59, 72}, GP{57, 70}]]}
    case 37n:
