      Glyph{56, 72, [[GP{58, 59}, GP{64, 73}], [GP{70, 59}, GP{64, 73}, GP{62, 77}, GP{60, 79}, GP{58, 80}, GP{57, 80}]]}
    case 122n:
      Glyph{56, 73, [[GP{70, 59}, GP{59, 73}], [GP{59, 59}, GP{70, 59}], [GP{59, 73}, GP{70, 73}]]}
    case 123n:
      Glyph{57, 71, [[GP{66, 48}, GP{64, 49}, GP{63, 50}, GP{62, 52}, GP{62, 54}, GP{63, 56}, GP{64, 57}, GP{65, 59}, GP{65, 61}, GP{63, 63}], [GP{64, 49}, GP{63, 51}, GP{63, 53}, GP{64, 55}, GP{65, 56}, GP{66, 58}, GP{66, 60}, GP{65, 62}, GP{61, 64}, GP{65, 66}, GP{66, 68}, GP{66, 70}, GP{65, 72}, GP{64, 73}, GP{63, 75}, GP{63, 77}, GP{64, 79}], [GP{63, 65}, GP{65, 67}, GP{65, 69}, GP{64, 71}, GP{63, 72}, GP{62, 74}, GP{62, 76}, GP{63, 78}, GP{64, 79}, GP{66, 80}]]}
    case 124n:
      Glyph{60, 68, [[GP{64, 48}, GP{64, 80}]]}
    case 125n:
      Glyph{57, 71, [[GP{62, 48}, GP{64, 49}, GP{65, 50}, GP{66, 52}, GP{66, 54}, GP{65, 56}, GP{64, 57}, GP{63, 59}, GP{63, 61}, GP{65, 63}], [GP{64, 49}, GP{65, 51}, GP{65, 53}, GP{64, 55}, GP{63, 56}, GP{62, 58}, GP{62, 60}, GP{63, 62}, GP{67, 64}, GP{63, 66}, GP{62, 68}, GP{62, 70}, GP{63, 72}, GP{64, 73}, GP{65, 75}, GP{65, 77}, GP{64, 79}], [GP{65, 65}, GP{63, 67}, GP{63, 69}, GP{64, 71}, GP{65, 72}, GP{66, 74}, GP{66, 76}, GP{65, 78}, GP{64, 79}, GP{62, 80}]]}
    case 126n:
      Glyph{52, 76, [[GP{55, 67}, GP{55, 65}, GP{56, 62}, GP{58, 61}, GP{60, 61}, GP{62, 62}, GP{66, 65}, GP{68, 66}, GP{70, 66}, GP{72, 65}, GP{73, 63}], [GP{55, 65}, GP{56, 63}, GP{58, 62}, GP{60, 62}, GP{62, 63}, GP{66, 66}, GP{68, 67}, GP{70, 67}, GP{72, 66}, GP{73, 63}, GP{73, 61}]]}
    case 176n:
      Glyph{59, 69, [[GP{63, 52}, GP{62, 53}, GP{62, 55}, GP{63, 56}, GP{65, 56}, GP{66, 55}, GP{66, 53}, GP{65, 52}, GP{63, 52}]]}
    case 177n:
      Glyph{51, 77, [[GP{64, 55}, GP{64, 71}], [GP{56, 63}, GP{72, 63}], [GP{56, 73}, GP{72, 73}]]}
    case 181n:
      Glyph{55, 74, [[GP{59, 59}, GP{59, 69}, GP{60, 72}, GP{62, 73}, GP{65, 73}, GP{67, 72}, GP{70, 69}], [GP{70, 59}, GP{70, 73}], [GP{59, 59}, GP{59, 80}]]}
    case _:
      Stroke.box()

def Stroke.ohm() -> Glyph:
  Glyph{54, 75, [[GP{57, 73}, GP{61, 73}, GP{58, 67}, GP{57, 63}, GP{57, 59}, GP{58, 55}, GP{61, 53}, GP{64, 52}, GP{65, 52}, GP{68, 53}, GP{71, 55}, GP{72, 59}, GP{72, 63}, GP{71, 67}, GP{68, 73}, GP{72, 73}]]}

def Stroke.glyph.k(low: Bool, ohm: Bool, +cp: U32) -> Glyph:
  match low ohm:
    case True{} _:
      Stroke.low(U32.to_nat(cp))
    case False{} True{}:
      Stroke.ohm()
    case False{} False{}:
      Stroke.box()

# the glyph for a code point
def Stroke.glyph(+cp: U32) -> Glyph:
  Stroke.glyph.k(U32.is_lt(cp, 256), Bool.or(U32.is_eq(cp, 937), U32.is_eq(cp, 8486)), cp)

# ---- layout (hand-written; scripts/strokefont-to-bend.py keeps this part) ----

# Markup
# ------
# KiCad text markup: ~{..} draws an overbar; _{..} and ^{..} (sub- and
# superscript) are drawn inline at full size; {slash}, {lt}, ... name a
# character; any other {..} is drawn as it is. A character after markup:

type Ch is Data:
  Ch{cp: U32, bar: Bool}

# the open markup braces (True: an overbar), whether to drop the next "{",
# the characters so far (reversed), and whether a {name} is being read (and
# its characters, reversed)
type MS is Data:
  MS{st: List<&2, Bool>, skip: Bool, acc: List<&2, Ch>, tin: Bool, tok: List<&2, U32>}

def Mark.bars(st: List<&2, Bool>) -> Bool:
  match st:
    case Nil{}:
      False{}
    case b <> t:
      Bool.or(b, Mark.bars(t))

def Mark.open(st: List<&2, Bool>) -> Bool:
  match st:
    case Nil{}:
      False{}
    case _ <> _:
      True{}

def Mark.pop(st: List<&2, Bool>) -> List<&2, Bool>:
  match st:
    case Nil{}:
      Nil{}
    case _ <> t:
      t

def Mark.next(s: String) -> U32:
  match s:
    case SCon{Chr{c}, _}:
      c
    case SNil{}:
      0

def Mark.opens(+c: U32, +nxt: U32) -> Bool:
  Bool.and(U32.is_eq(nxt, 123), Bool.or(U32.is_eq(c, 126), Bool.or(U32.is_eq(c, 95), U32.is_eq(c, 94))))

def Mark.str(xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}:
      SNil{}
    case x <> t:
      SCon{Chr{x}, Mark.str(t)}

# the character a {name} stands for (0: none)
def Mark.var(+n: String) -> U32:
  Bool.pick(U32, String.eq(n, "slash"), 47, Bool.pick(U32, String.eq(n, "backslash"), 92, Bool.pick(U32, String.eq(n, "dblquote"), 34,
  Bool.pick(U32, String.eq(n, "quote"), 39, Bool.pick(U32, String.eq(n, "lt"), 60, Bool.pick(U32, String.eq(n, "gt"), 62,
  Bool.pick(U32, String.eq(n, "colon"), 58, Bool.pick(U32, String.eq(n, "comma"), 44, Bool.pick(U32, String.eq(n, "space"), 32,
  Bool.pick(U32, String.eq(n, "tab"), 32, Bool.pick(U32, String.eq(n, "return"), 10, Bool.pick(U32, String.eq(n, "brl"), 123,
  Bool.pick(U32, String.eq(n, "brr"), 125, 0)))))))))))))

# the name's characters (reversed) onto the reversed output
def Mark.lit(tok: List<&2, U32>, +bar: Bool, rest: List<&2, Ch>) -> List<&2, Ch>:
  match tok:
    case Nil{}:
      rest
    case c <> t:
      Ch{c, bar} <> Mark.lit(t, bar, rest)

def Mark.var.k(known: Bool, +v: U32, tok: List<&2, U32>, +bar: Bool, acc: List<&2, Ch>) -> List<&2, Ch>:
  match known:
    case True{}:
      Ch{v, bar} <> acc
    case False{}:
      Ch{125, bar} <> Mark.lit(tok, bar, Ch{123, bar} <> acc)

def Mark.var.put(+tok: List<&2, U32>, +bar: Bool, acc: List<&2, Ch>) -> List<&2, Ch>:
  +v = Mark.var(Mark.str(List.reverse(&2, U32, tok)))
  Mark.var.k(U32.is_ne(v, 0), v, tok, bar, acc)

def Mark.step.k(skip: Bool, tin: Bool, op: Bool, br: Bool, cl: Bool, pop: Bool, +c: U32, +st: List<&2, Bool>, acc: List<&2, Ch>, tok: List<&2, U32>) -> MS:
  match skip tin op br cl pop:
    case True{} _ _ _ _ _:
      MS{st, False{}, acc, False{}, Nil{}}
    case False{} True{} _ _ True{} _:
      MS{st, False{}, Mark.var.put(tok, Mark.bars(st), acc), False{}, Nil{}}
    case False{} True{} _ _ False{} _:
      MS{st, False{}, acc, True{}, c <> tok}
    case False{} False{} True{} _ _ _:
      MS{U32.is_eq(c, 126) <> st, True{}, acc, False{}, Nil{}}
    case False{} False{} False{} True{} _ _:
      MS{st, False{}, acc, True{}, Nil{}}
    case False{} False{} False{} False{} True{} True{}:
      MS{Mark.pop(st), False{}, acc, False{}, Nil{}}
    case False{} False{} False{} False{} _ _:
      MS{st, False{}, Ch{c, Mark.bars(st)} <> acc, False{}, Nil{}}

def Mark.step(ms: MS, +c: U32, +nxt: U32) -> MS:
  match ms:
    case MS{+st, skip, acc, tin, tok}:
      Mark.step.k(skip, tin, Mark.opens(c, nxt), U32.is_eq(c, 123), U32.is_eq(c, 125), Mark.open(st), c, st, acc, tok)

def Mark.fin.k(tin: Bool, acc: List<&2, Ch>, tok: List<&2, U32>) -> List<&2, Ch>:
  match tin:
    case True{}:
      List.reverse(&2, Ch, Mark.lit(tok, False{}, Ch{123, False{}} <> acc))
    case False{}:
      List.reverse(&2, Ch, acc)

def Mark.fin(ms: MS) -> List<&2, Ch>:
  match ms:
    case MS{_, _, acc, tin, tok}:
      Mark.fin.k(tin, acc, tok)

def Mark.go(s: String, ms: MS) -> List<&2, Ch>:
  match s:
    case SNil{}:
      Mark.fin(ms)
    case SCon{Chr{+c}, +t}:
      Mark.go(t, Mark.step(ms, c, Mark.next(t)))

# the characters a text draws
def Mark.chars(s: String) -> List<&2, Ch>:
  Mark.go(s, MS{Nil{}, False{}, Nil{}, False{}, Nil{}})

# Lines
# -----

type GC is Data:
  GC{cp: U32, g: Glyph, bar: Bool}

def Lay.glyphs(cs: List<&2, Ch>) -> List<&2, GC>:
  match cs:
    case Nil{}:
      Nil{}
    case Ch{+cp, bar} <> t:
      GC{cp, Stroke.glyph(cp), bar} <> Lay.glyphs(t)

def Lay.split.k(nl: Bool, c: GC, r: List<&2, List<&2, GC>>) -> List<&2, List<&2, GC>>:
  match nl r:
    case True{} _:
      Nil{} <> r
    case False{} l <> rt:
      (c <> l) <> rt
    case False{} Nil{}:
      [[c]]

def Lay.nl(c: GC) -> Bool:
  match c:
    case GC{cp, _, _}:
      U32.is_eq(cp, 10)

# the lines of a text (split at "\n")
def Lay.split(cs: List<&2, GC>) -> List<&2, List<&2, GC>>:
  match cs:
    case Nil{}:
      [Nil{}]
    case +c <> t:
      Lay.split.k(Lay.nl(c), c, Lay.split(t))

# a line's advance in glyph units
def Lay.units(cs: List<&2, GC>) -> F32:
  match cs:
    case Nil{}:
      0.0
    case GC{_, Glyph{l, r, _}, _} <> t:
      F32.add(F32.sub(U32.to_f32(r), U32.to_f32(l)), Lay.units(t))

def Lay.widest(ls: List<&2, List<&2, GC>>) -> F32:
  match ls:
    case Nil{}:
      0.0
    case l <> t:
      F32.max(Lay.units(l), Lay.widest(t))

# Placement
# ---------

# origin, rotation (cos, sin), mirror (1 or -1), mm per glyph unit across
# and down, the pen width, and the italic slant
type TF is Data:
  TF{x: F32, y: F32, c: F32, s: F32, m: F32, sx: F32, sy: F32, pen: F32, it: F32}

def TF.sx(tf: TF) -> F32:
  match tf:
    case TF{_, _, _, _, _, sx, _, _, _}:
      sx

def TF.sy(tf: TF) -> F32:
  match tf:
    case TF{_, _, _, _, _, _, sy, _, _}:
      sy

def TF.pen(tf: TF) -> F32:
  match tf:
    case TF{_, _, _, _, _, _, _, pen, _}:
      pen

def TF.it(tf: TF) -> F32:
  match tf:
    case TF{_, _, _, _, _, _, _, _, it}:
      it

# a text-frame point (u right, v down, mm) on the sheet
def TF.pt(tf: TF, +u: F32, +v: F32) -> B.Pt:
  match tf:
    case TF{x, y, +c, +s, m, _, _, _, _}:
      +um = F32.mul(u, m)
      B.Pt{F32.add(x, F32.add(F32.mul(um, c), F32.mul(v, s))), F32.sub(F32.add(y, F32.mul(v, c)), F32.mul(um, s))}

# the glyph origin (u0) is where its left bearing sits; v0 is the baseline
def Lay.pts(ps: List<&2, GP>, +tf: TF, +u0: F32, +l: F32, +v0: F32) -> List<&2, B.Pt>:
  match ps:
    case Nil{}:
      Nil{}
    case GP{gx, gy} <> t:
      +dv = F32.mul(F32.sub(U32.to_f32(gy), 73.0), TF.sy(tf))
      TF.pt(tf, F32.sub(F32.add(u0, F32.mul(F32.sub(U32.to_f32(gx), l), TF.sx(tf))), F32.mul(dv, TF.it(tf))), F32.add(v0, dv))
        <> Lay.pts(t, tf, u0, l, v0)

def Lay.strokes(ss: List<&2, List<&2, GP>>, +tf: TF, +u0: F32, +l: F32, +v0: F32, rest: List<&2, B.Prim>) -> List<&2, B.Prim>:
  match ss:
    case Nil{}:
      rest
    case p <> t:
      B.PLine{Lay.pts(p, tf, u0, l, v0), TF.pen(tf)} <> Lay.strokes(t, tf, u0, l, v0, rest)

def Lay.bar(bar: Bool, +tf: TF, +u0: F32, +adv: F32, +v0: F32, rest: List<&2, B.Prim>) -> List<&2, B.Prim>:
  match bar:
    case True{}:
      +v = F32.sub(v0, F32.mul(26.0, TF.sy(tf)))
      B.PSeg{TF.pt(tf, u0, v), TF.pt(tf, F32.add(u0, adv), v), TF.pen(tf)} <> rest
    case False{}:
      rest

# one line from pen position u (mm) on baseline v0
def Lay.chars(cs: List<&2, GC>, +tf: TF, +u: F32, +v0: F32) -> List<&2, B.Prim>:
  match cs:
    case Nil{}:
      Nil{}
    case GC{_, Glyph{+l, +r, ss}, bar} <> t:
      +adv = F32.mul(F32.sub(U32.to_f32(r), U32.to_f32(l)), TF.sx(tf))
      Lay.strokes(ss, tf, u, U32.to_f32(l), v0, Lay.bar(bar, tf, u, adv, v0, Lay.chars(t, tf, F32.add(u, adv), v0)))

def Lay.lines(ls: List<&2, List<&2, GC>>, +tf: TF, +hj: F32, +v0: F32, +pitch: F32) -> List<&2, B.Prim>:
  match ls:
    case Nil{}:
      Nil{}
    case +l <> t:
      List.append(&2, B.Prim, Lay.chars(l, tf, F32.neg(F32.mul(F32.mul(Lay.units(l), TF.sx(tf)), hj)), v0),
        Lay.lines(t, tf, hj, F32.add(v0, pitch), pitch))

# Text
# ----

# glyph width scale (Hershey's own widths give KiCad's text lengths)
def Stroke.narrow() -> F32:
  1.0

# the distance between baselines, per unit of text height
def Stroke.pitch() -> F32:
  1.62

def Stroke.mirror(m: Bool) -> F32:
  match m:
    case True{}:
      F32.neg(1.0)
    case False{}:
      1.0

# Text as strokes in sheet (or board) millimetres, KiCad-style: (x, y) is the
# anchor; h and w are the text height and character width, pen the stroke
# width, angle counter-clockwise in radians (Y points down); hj is 0 left,
# 1 centre, 2 right; vj is 0 top, 1 centre, 2 bottom (the anchor is on the
# cap line, the middle, or the last baseline); mirror flips it about the
# anchor; italic slants it. Lines break at "\n".
def Stroke.text.full(+s: String, +x: F32, +y: F32, +h: F32, +w: F32, +pen: F32, +angle: F32, +hj: U32, +vj: U32, +mirror: Bool, +italic: Bool) -> List<&2, B.Prim>:
  +ls = Lay.split(Lay.glyphs(Mark.chars(s)))
  +bh = F32.add(h, F32.mul(F32.mul(F32.sub(F32.from_nat(List.length(&2, List<&2, GC>, ls)), 1.0), Stroke.pitch()), h))
  Lay.lines(ls, TF{x, y, F32.cos(angle), F32.sin(angle), Stroke.mirror(mirror), F32.div(F32.mul(w, Stroke.narrow()), 21.0), F32.div(h, 21.0), pen, Bool.pick(F32, italic, 0.2, 0.0)},
    F32.mul(U32.to_f32(hj), 0.5), F32.sub(h, F32.mul(bh, F32.mul(U32.to_f32(vj), 0.5))), F32.mul(Stroke.pitch(), h))

# text of height `size` with a stroke of size/8
def Stroke.text(+s: String, +x: F32, +y: F32, +size: F32, +angle: F32, +hj: U32, +vj: U32, +mirror: Bool) -> List<&2, B.Prim>:
  Stroke.text.full(s, x, y, size, size, F32.div(size, 8.0), angle, hj, vj, mirror, False{})

# the widest line's advance in mm, for character width w
def Stroke.width(+s: String, +w: F32) -> F32:
  F32.mul(Lay.widest(Lay.split(Lay.glyphs(Mark.chars(s)))), F32.div(F32.mul(w, Stroke.narrow()), 21.0))

# the number of lines
def Stroke.lines(+s: String) -> Nat:
  List.length(&2, List<&2, GC>, Lay.split(Lay.glyphs(Mark.chars(s))))

# Wrapping
# --------

# the line being filled, its width, and the lines so far (reversed)
type WS is Data:
  WS{line: String, lw: F32, out: List<&2, String>}

def Wrap.step.k(empty: Bool, fits: Bool, +word: String, +ww: F32, line: String, +lw: F32, out: List<&2, String>, +sp: F32) -> WS:
  match empty fits:
    case True{} _:
      WS{word, ww, out}
    case False{} True{}:
      WS{line ++ " " ++ word, F32.add(lw, F32.add(sp, ww)), out}
    case False{} False{}:
      WS{word, ww, line <> out}

def Wrap.step(st: WS, +word: String, +w: F32, +maxw: F32) -> WS:
  match st:
    case WS{+line, +lw, out}:
      +ww = Stroke.width(word, w)
      +sp = Stroke.width(" ", w)
      Wrap.step.k(String.is_empty(line), F32.is_le(F32.add(lw, F32.add(sp, ww)), maxw), word, ww, line, lw, out, sp)

def Wrap.fin(st: WS) -> List<&2, String>:
  match st:
    case WS{line, _, out}:
      List.reverse(&2, String, line <> out)

def Wrap.go(ws: List<&2, String>, st: WS, +w: F32, +maxw: F32) -> List<&2, String>:
  match ws:
    case Nil{}:
      Wrap.fin(st)
    case x <> t:
      Wrap.go(t, Wrap.step(st, x, w, maxw), w, maxw)

def Wrap.paras(ps: List<&2, String>, +w: F32, +maxw: F32) -> List<&2, String>:
  match ps:
    case Nil{}:
      Nil{}
    case p <> t:
      List.append(&2, String, Wrap.go(String.split(p, ' '), WS{"", 0.0, Nil{}}, w, maxw), Wrap.paras(t, w, maxw))

# the text with line breaks added at spaces so that no line (of character
# width w) is wider than maxw mm, where words allow
def Stroke.wrap(s: String, +w: F32, +maxw: F32) -> String:
  String.join(Wrap.paras(String.split(s, '\n'), w, maxw), "\n")
